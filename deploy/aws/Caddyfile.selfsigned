# Urgent testing — self-signed HTTPS (browser warning; mic works after accept).
# Generated by enable-https.sh when OOA_DOMAIN is unset.

{
	auto_https disable_redirects
}

:443 {
	@http {
		protocol http
	}
	handle @http {
		redir https://{host}{uri} permanent
	}

	tls internal {
		on_demand
	}

	encode gzip
	reverse_proxy gateway:8000
}
