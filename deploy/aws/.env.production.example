# OOA production — copy to repo root as .env.production (never commit)
# Used by: docker compose -f deploy/aws/docker-compose.prod.yml --env-file .env.production

# --- Postgres (compose service) ---
POSTGRES_USER=ooa
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=ooa

# --- Image (ECR) — set after first push ---
# OOA_IMAGE=123456789012.dkr.ecr.me-south-1.amazonaws.com/ooa-gateway:latest
OOA_HTTP_PORT=8000

# --- Odoo 14 (Elrace production) ---
ODOO_V14_URL=https://odoo.elrace.com
ODOO_V14_DB=odoo.elrace.com
ODOO_V14_USER=dev
ODOO_V14_PASSWORD=YOUR_ODOO_API_KEY
# Optional: skip authenticate() RPC if Odoo license limit blocks login (password still validated per call)
# ODOO_V14_UID=4291
ODOO_EMPLOYEE_ID_FIELDS=emp_id,employee_code,barcode,identification_id
ODOO_XMLRPC_TIMEOUT=600

# --- Auth / admin ---
JWT_SECRET=CHANGE_ME_256_BIT_RANDOM
JWT_ACCESS_HOURS=8
JWT_REFRESH_DAYS=30
RBAC_ENFORCE=true
SUPER_ADMIN_FILE_ID=2721
SUPER_ADMIN_NAME="Super Administrator"
SUPER_ADMIN_EMAIL=admin@elrace.com
AUTH_VERIFY_ODOO_ON_LOGIN=false
# Skip Odoo employee verify on login when cache is fresh (hours). 0 = always sync.
AUTH_ODOO_SYNC_TTL_HOURS=24

# --- AI keys ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# --- Optional tuning ---
OOA_LOG_LEVEL=INFO
OOA_CREDIT_CHECKS_ENABLED=true
SCHEMA_CACHE_DIR=.cache/schema

# --- Monitoring (full stack on EC2) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
OOA_GRAFANA_PORT=3030
OOA_PROMETHEUS_PORT=9090
OOA_ALERTMANAGER_PORT=9093
OOA_LOKI_PORT=3100
