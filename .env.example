# OOA Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Odoo 14 Connection
ODOO_V14_URL=http://your-odoo14-instance.com
ODOO_V14_DB=your_database
ODOO_V14_USER=admin
ODOO_V14_API_KEY=your_api_key_here

# Odoo 18 Connection
ODOO_V18_URL=http://your-odoo18-instance.com
ODOO_V18_DB=your_database
ODOO_V18_USER=admin
ODOO_V18_API_KEY=your_api_key_here

# LLM
ANTHROPIC_API_KEY=your_claude_api_key

# Voice
OPENAI_API_KEY=your_openai_whisper_key
ELEVENLABS_API_KEY=your_elevenlabs_key

# Database (Session Persistence)
POSTGRES_DSN=postgresql://user:password@localhost:5432/ooa_sessions

# Cache
SCHEMA_CACHE_DIR=.cache/schema
