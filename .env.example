# OOA Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Odoo 14 Connection
ODOO_V14_URL=http://your-odoo14-instance.com
ODOO_V14_DB=your_database
ODOO_V14_USER=admin
ODOO_V14_API_KEY=your_api_key_here

# Odoo 18 Connection
ODOO_V18_URL=http://your-odoo18-instance.com
ODOO_V18_DB=your_database
ODOO_V18_USER=admin
ODOO_V18_API_KEY=your_api_key_here

# LLM
ANTHROPIC_API_KEY=your_claude_api_key

# Voice
OPENAI_API_KEY=your_openai_whisper_key
ELEVENLABS_API_KEY=your_elevenlabs_key

# Database (Session Persistence — legacy compose postgres)
POSTGRES_DSN=postgresql://ooa:changeme@localhost:5432/ooa_sessions

# Admin panel PostgreSQL (Phase 1+) — also stores chat history when set
#
# Option A — Docker (requires: docker compose -f docker-compose.admin-db.yml up -d)
# OOA_DB_URL=postgresql://postgres:devpassword@localhost:5433/ooa
#
# Option B — Local Homebrew Postgres (port 5432): createdb ooa
OOA_DB_URL=postgresql://YOUR_MAC_USERNAME@localhost:5432/ooa
SUPER_ADMIN_FILE_ID=2721
SUPER_ADMIN_NAME="Super Administrator"
SUPER_ADMIN_EMAIL=admin@elrace.com

# Phase 2+ authentication
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_HOURS=8
JWT_REFRESH_DAYS=30

# Phase 3 RBAC — enforce JWT on /chat when OOA_DB_URL is set (default true)
RBAC_ENFORCE=true

# Odoo PostgreSQL (Direct SQL for financial reports — same database as ODOO_V14_DB)
ODOO_POSTGRES_DSN=postgresql://user:password@localhost:5432/odoo.elrace.com

# Cache
SCHEMA_CACHE_DIR=.cache/schema
