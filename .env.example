# OOA Environment Configuration — copy to .env and fill in values.
# NEVER commit .env to version control.

# Odoo 14
ODOO_V14_URL=http://your-odoo14-instance.com
ODOO_V14_DB=your_database
ODOO_V14_USER=admin
# Use an Odoo API key (Settings → Users → API Keys), not the web UI password.
# If authenticate fails with "user_id is ambiguous", fix custom Odoo addons (e.g. jwt_provider) on the server.
ODOO_V14_PASSWORD=your_odoo_api_key
# Optional: skip authenticate() RPC when Odoo user-limit blocks login (execute_kw still checks password)
# ODOO_V14_UID=4291
ODOO_V14_TEST_PROJECT_ID=
# hr.employee fields matched to OOA File ID (emp_id first for Elrace)
ODOO_EMPLOYEE_ID_FIELDS=emp_id,employee_code,barcode,identification_id
ODOO_XMLRPC_TIMEOUT=600

# Odoo 18 (optional)
#ODOO_V18_URL=
#ODOO_V18_DB=
#ODOO_V18_USER=
#ODOO_V18_API_KEY=

# Direct SQL (optional)
#ODOO_POSTGRES_DSN=postgresql://user:pass@localhost:5432/odoo_db
#OOA_GL_SKIP_AI=false

# Admin DB — pick one:
# OOA_DB_URL=postgresql://postgres:devpassword@localhost:5433/ooa
OOA_DB_URL=postgresql://YOUR_MAC_USERNAME@localhost:5432/ooa

JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_HOURS=8
JWT_REFRESH_DAYS=30
RBAC_ENFORCE=true
SUPER_ADMIN_FILE_ID=2721
SUPER_ADMIN_NAME="Super Administrator"
SUPER_ADMIN_EMAIL=admin@example.com
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_VERIFY_ODOO_ON_LOGIN=false
# Skip Odoo employee verify on login when cache is fresh (hours). 0 = always sync.
AUTH_ODOO_SYNC_TTL_HOURS=24
AUTH_PASSWORD_RESET_HOURS=1
AUTH_LOGIN_LIMIT=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_ADMIN_LIMIT_PER_MIN=60
SESSION_IDLE_MINUTES=60

ANTHROPIC_API_KEY=your_claude_api_key
OPENAI_API_KEY=your_openai_key
ELEVENLABS_API_KEY=your_elevenlabs_key

OOA_TOKEN_CENTS_PER_1K=0.35
OOA_PDF_CENTS=25
OOA_VOICE_CENTS_PER_MIN=8

OOA_GATEWAY_HOST=0.0.0.0
OOA_GATEWAY_PORT=8000

OOA_LOG_JSON=true
OOA_LOG_LEVEL=INFO
OOA_LOG_FILE=logs/ooa-gateway.jsonl

OOA_CREDIT_CHECKS_ENABLED=true
OOA_CREDIT_CHECK_MINUTES=15
OOA_CREDIT_CHECK_TIMEOUT=15
OOA_CREDIT_CHECK_INITIAL_DELAY=10
ANTHROPIC_CREDIT_BUDGET_CENTS=10000

OOA_PROMETHEUS_URL=http://127.0.0.1:9090
OOA_ALERTMANAGER_URL=http://127.0.0.1:9093
OOA_LOKI_URL=http://127.0.0.1:3100
GRAFANA_ADMIN_PASSWORD=admin
POSTGRES_EXPORTER_DSN=postgresql://postgres:devpassword@host.docker.internal:5433/ooa?sslmode=disable

ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_SMTP_HOST=smtp.gmail.com:587
ALERT_EMAIL_FROM=ooa-alerts@example.com
ALERT_EMAIL_TO=admin@example.com
ALERT_EMAIL_USERNAME=
ALERT_EMAIL_PASSWORD=
ALERT_CRITICAL_EMAIL_TO=admin@example.com
ALERT_SLACK_ENABLED=false
ALERT_SLACK_WEBHOOK_URL=
ALERT_SLACK_CHANNEL=#ooa-alerts
ALERT_SLACK_CRITICAL_CHANNEL=#ooa-alerts-critical

SCHEMA_CACHE_DIR=.cache/schema
OOA_TEST_BASE=http://127.0.0.1:8000
